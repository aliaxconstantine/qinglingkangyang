<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aliax.qlky.mapper.CrawlerDataFieldMapper">

    <select id="selectListByCrawlerId" resultType="com.aliax.qlky.entity.CrawlerDataFieldEntity">
        SELECT * FROM crawler_data_field WHERE crawler_id = #{crawlerId}
        <if test="index != null">
            LIMIT #{len}, #{index};
        </if>
    </select>
</mapper>
