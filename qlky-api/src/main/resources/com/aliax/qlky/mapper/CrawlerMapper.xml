<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aliax.qlky.mapper.CrawlerMapper">

    <select id="selectCrawlerList" resultType="com.aliax.qlky.entity.CrawlerEntity">
        SELECT * FROM crawler
        <where>
            <if test="crawlerName != null and crawlerName != ''">
                AND crawler_name = #{crawlerName}
            </if>
            <if test="crawlerProgramPath != null and crawlerProgramPath != ''">
                AND crawler_program_path = #{crawlerProgramPath}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>
</mapper>
